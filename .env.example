# Copy this file to .env and fill in real values. 

# --- arXiv fetch (ArxivSettings) ---
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
ARXIV_SEARCH_CATEGORY=cat:physics.chem-ph
ARXIV_PAGE_SIZE=100
ARXIV_MAX_RESULTS=200
ARXIV_RATE_LIMIT_DELAY=3.0

# --- Embeddings (EmbeddingSettings) ---
EMBEDDING_PROVIDER=specter2
EMBEDDING_MODEL=allenai/specter2_base
EMBEDDING_BATCH_SIZE=32

# --- Postgres (PostgresSettings) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=chem_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- FAISS (FaissSettings) ---
FAISS_INDEX_PATH=data/faiss/papers.index

# --- Groq LLM (GroqSettings) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=1024

# --- RAG (RagSettings) ---
RAG_TOP_K=5